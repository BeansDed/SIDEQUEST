{
  "name": "sidequest-platform",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/admin run dev",
    "build": "npm --prefix apps/admin run build",
    "test": "npm run test:shared && npm run test:admin",
    "test:admin": "npm --prefix apps/admin run test",
    "test:shared": "npm --prefix packages/shared run test",
    "typecheck": "npm run typecheck:shared && npm run typecheck:admin",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "typecheck:shared": "npm --prefix packages/shared run typecheck"
  }
}
