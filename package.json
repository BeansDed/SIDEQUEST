{
  "name": "sidequest-platform",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/admin run dev",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:web": "npm --prefix apps/mobile run web",
    "build": "npm --prefix apps/admin run build",
    "test": "npm run test:shared && npm run test:admin",
    "test:mobile": "npm --prefix apps/mobile run test",
    "test:admin": "npm --prefix apps/admin run test",
    "test:shared": "npm --prefix packages/shared run test",
    "typecheck": "npm run typecheck:shared && npm run typecheck:admin",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "build:mobile": "npm --prefix apps/mobile run export",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "typecheck:shared": "npm --prefix packages/shared run typecheck",
    "e2e": "npm --prefix apps/admin run e2e",
    "verify": "npm run test && npm run typecheck && npm run build"
  }
}
